@prefix ex: <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Cuisine a rdfs:Class ;
    rdfs:label "Cuisine"@en ;
    rdfs:comment "A culinary tradition or cuisine style."@en .

ex:DietType a rdfs:Class ;
    rdfs:label "Diet type"@en ;
    rdfs:comment "A dietary category such as vegan or vegetarian."@en .

ex:Ingredient a rdfs:Class ;
    rdfs:label "Ingredient"@en ;
    rdfs:comment "A food ingredient used in a recipe."@en .

ex:MealType a rdfs:Class ;
    rdfs:label "Meal type"@en ;
    rdfs:comment "The type of meal, such as breakfast or dinner."@en .

ex:RecipeCategory a rdfs:Class ;
    rdfs:label "Recipe category"@en ;
    rdfs:comment "A category such as soup, salad, or pasta."@en .

ex:SkillLevel a rdfs:Class .

ex:Antihero rdfs:label "Antihero"@en ;
    rdfs:comment "A character with ambiguous morals who may act heroically."@en .

ex:Apple a ex:Ingredient ;
    schema:name "Apple" .

ex:Artifact rdfs:label "Artifact"@en ;
    rdfs:comment "A notable object or weapon used by characters."@en .

ex:Bacon a ex:Ingredient ;
    schema:name "Bacon" .

ex:BakingPowder a ex:Ingredient ;
    schema:name "Baking Powder" .

ex:Beans a ex:Ingredient ;
    schema:name "Beans" .

ex:Beef a ex:Ingredient ;
    schema:name "Beef" .

ex:Brazilian a ex:Cuisine ;
    schema:name "Brazilian" .

ex:Cauliflower a ex:Ingredient ;
    schema:name "Cauliflower" .

ex:Chocolate a ex:Ingredient ;
    schema:name "Chocolate" .

ex:City rdfs:label "City"@en ;
    rdfs:comment "A fictional or real location where characters operate."@en .

ex:Civilian rdfs:label "Civilian"@en ;
    rdfs:comment "A non-superpowered supporting character."@en .

