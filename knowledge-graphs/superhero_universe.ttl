@prefix ex: <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Antihero a rdfs:Class ;
    rdfs:label "Antihero"@en ;
    rdfs:comment "A character with ambiguous morals who may act heroically."@en .

ex:Artifact a rdfs:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "A notable object or weapon used by characters."@en .

ex:City a rdfs:Class ;
    rdfs:label "City"@en ;
    rdfs:comment "A fictional or real location where characters operate."@en .

ex:Civilian a rdfs:Class ;
    rdfs:label "Civilian"@en ;
    rdfs:comment "A non-superpowered supporting character."@en .

ex:Nation a rdfs:Class .

ex:Organization a rdfs:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An organization, company, or agency connected to characters."@en .

ex:Power a rdfs:Class ;
    rdfs:label "Power"@en ;
    rdfs:comment "An extraordinary ability or skill."@en .

ex:Publisher a rdfs:Class .

ex:Species a rdfs:Class .

ex:Superhero a rdfs:Class ;
    rdfs:label "Superhero"@en ;
    rdfs:comment "A fictional heroic character with extraordinary abilities or skills."@en .

ex:Team a rdfs:Class ;
    rdfs:label "Team"@en ;
    rdfs:comment "A group or alliance of comic-book characters."@en .

ex:Villain a rdfs:Class ;
    rdfs:label "Villain"@en ;
    rdfs:comment "A fictional antagonist or adversary in the superhero universe."@en .

ex:AForce a ex:Team ;
    schema:name "A-Force" .

